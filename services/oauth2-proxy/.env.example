# Real values go in .env (gitignored, host-only) -- never commit real secrets here.
#
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID
# ("External" user type, publishing status "Testing" is fine -- up to 100 test
# users, no verification review needed). Add BOTH redirect URIs below as
# "Authorized redirect URIs" on that client, and add both allowed emails as
# "Test users" on the OAuth consent screen too (a second, independent check
# beyond this service's own authenticated-emails.txt allowlist).
#   Redirect URI 1: https://tyche.project-aegis.io/oauth2/callback
#   Redirect URI 2: https://project-aegis.io/oauth2/callback
OAUTH2_PROXY_CLIENT_ID=your_google_oauth_client_id_here
OAUTH2_PROXY_CLIENT_SECRET=your_google_oauth_client_secret_here

# Generate once with: openssl rand -base64 32 | head -c 32
# MUST be the same value for both instances (oauth2-proxy-tyche and
# oauth2-proxy-homer share this file) -- it's what makes a single Google
# login, on either entry point, cover both.
OAUTH2_PROXY_COOKIE_SECRET=generate_a_real_32_byte_secret_here
