# ============================================================
# Aegis Infrastructure — Environment Variables
# Copy this to .env and fill in real values.
# NEVER commit .env to git.
# ============================================================

# --- Tailscale ---
# Auth key for non-interactive tailscale up (generate at login.tailscale.com/admin/settings/keys)
TAILSCALE_AUTHKEY=tskey-auth-REPLACE_ME

# Aegis Tailscale IP (set after first tailscale up, run: tailscale ip)
AEGIS_TAILSCALE_IP=100.97.183.96

# --- Cloudflare ---
# Scoped API token: Zone:Read + DNS:Edit for project-aegis.io only
CF_API_TOKEN=REPLACE_ME

# --- GitHub Actions Runner ---
# Repo URL for the self-hosted runner
GITHUB_REPO_URL=https://github.com/Bhonchie/family-finance-hub
# Runner registration token (get from: repo → Settings → Actions → Runners → New runner)
GITHUB_RUNNER_TOKEN=REPLACE_ME
